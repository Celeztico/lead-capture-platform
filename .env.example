# Application
APP_NAME="Lead Capture Platform"
APP_ENV="development"
DEBUG="true"

# Security
SECRET_KEY="change-me-in-production-use-a-secure-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="30"

# Database (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/leadcapture"

# Rate Limiting
RATE_LIMIT_PER_MINUTE_IP="10"
RATE_LIMIT_PER_MINUTE_WIDGET="30"

# Geolocation Providers (fallback chain)
GEO_PROVIDER_A_URL="https://ipapi.co"
GEO_PROVIDER_B_URL="https://ipinfo.io"
GEO_REQUEST_TIMEOUT_SECONDS="2"

# Email (optional - stubbed for internship)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# Webhooks (optional - stubbed for internship)
WEBHOOK_SIGNING_SECRET=""

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database initialization (set to "true" only for tests/dev without migrations)
CREATE_TABLES_ON_STARTUP="false"